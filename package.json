{
  "name": "dragon-boat-training",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "build:backend": "node backend/build.mjs",
    "build:bridge-probe": "node backend/build-bridge-probe.mjs",
    "test": "node --test tests/*.test.mjs",
    "source:oauth": "node backend/source-journal/oauth-local.mjs",
    "source:check": "tsc --project backend/source-journal/tsconfig.json --noEmit",
    "source:host:build": "node backend/source-journal/build-host.mjs",
    "source:host": "node backend/source-journal/host.mjs",
    "backup:business:build": "node backend/backup/build.mjs",
    "backup:business": "node backend/backup/cli.mjs",
    "backup:reconcile:bootstrap": "node backend/backup/reconcile.mjs",
    "coach:rotate": "node backend/coach/cli.mjs",
    "cf:types": "wrangler types --config cloudflare/wrangler.jsonc cloudflare/worker-configuration.d.ts",
    "cf:check": "tsc --project cloudflare/tsconfig.json --noEmit",
    "cf:private:check": "tsc --project cloudflare/source-private/tsconfig.json --noEmit",
    "cf:private:test": "vitest run --config cloudflare/source-private/vitest.config.ts",
    "cf:private:dry-run": "wrangler deploy --config cloudflare/source-private/wrangler.jsonc --dry-run --outdir cloudflare/source-private/.wrangler-dry-run",
    "cf:recovery:dry-run": "wrangler deploy --config cloudflare/recovery.wrangler.jsonc --dry-run --outdir cloudflare/.wrangler-recovery-dry-run",
    "cf:recovery:test": "vitest run --config cloudflare/recovery.vitest.config.ts",
    "cf:test": "vitest run --config cloudflare/vitest.config.ts",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc --env=",
    "cf:accept:c1-staging": "node --env-file=cloudflare/.dev.vars tests/live-c1-staging-acceptance.mjs",
    "cf:deploy:staging": "wrangler deploy --config cloudflare/wrangler.jsonc --env=",
    "cf:deploy:c2test": "wrangler deploy --config cloudflare/wrangler.jsonc --env c2test",
    "cf:deploy:production": "wrangler deploy --config cloudflare/wrangler.jsonc --env production",
    "cf:dry-run": "wrangler deploy --config cloudflare/wrangler.jsonc --env= --dry-run --outdir cloudflare/.wrangler-dry-run",
    "cf:bootstrap:prepare": "node cloudflare/tools/c2-bootstrap.mjs prepare",
    "cf:bootstrap:dry-run": "node cloudflare/tools/c2-bootstrap.mjs dry-run"
  },
  "dependencies": {
    "@tailwindcss/vite": "latest",
    "astro": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@google/clasp": "^3.4.1",
    "esbuild": "0.28.2",
    "google-auth-library": "10.5.0",
    "typescript": "latest",
    "vitest": "^4.1.11",
    "wrangler": "4.135.0"
  }
}
