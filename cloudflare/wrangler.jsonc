{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dragon-boat-training-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "SERVICE_VERSION": "0.10.0-c2-sheet-inspection",
    "CONTRACT_VERSION": "2026-09-19.c0",
    "BACKEND_INSTANCE": "dragon-boat-training-staging",
    "BACKEND_GENERATION": "cf-c2-staging-4",
    "WRITER_EPOCH": "0",
    "TEAM_ID": "pentasus",
    "C2_FORM_POLL_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TEAM_STATE",
        "class_name": "TeamState"
      }
    ]
  },
  "exports": {
    "TeamState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "c2test": {
      "name": "dragon-boat-training-api-c2-test",
      "triggers": { "crons": [] },
      "vars": {
        "ENVIRONMENT": "staging",
        "SERVICE_VERSION": "0.10.0-c2-sheet-inspection",
        "CONTRACT_VERSION": "2026-09-19.c0",
        "BACKEND_INSTANCE": "dragon-boat-training-c2-test",
        "BACKEND_GENERATION": "cf-c2-isolated-1",
        "WRITER_EPOCH": "0",
        "TEAM_ID": "pentasus-c2-test",
        "C2_FORM_POLL_ENABLED": "false"
      },
      "durable_objects": {
        "bindings": [
          { "name": "TEAM_STATE", "class_name": "TeamState" }
        ]
      }
    },
    "production": {
      "name": "dragon-boat-training-api",
      "triggers": { "crons": [] },
      "vars": {
        "ENVIRONMENT": "production",
        "SERVICE_VERSION": "0.1.0-c0",
        "CONTRACT_VERSION": "2026-09-19.c0",
        "BACKEND_INSTANCE": "dragon-boat-training-production",
        "BACKEND_GENERATION": "cf-c0-production-1",
        "WRITER_EPOCH": "0",
        "TEAM_ID": "pentasus",
        "C2_FORM_POLL_ENABLED": "false"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "TEAM_STATE",
            "class_name": "TeamState"
          }
        ]
      }
    }
  }
}
