{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dragon-boat-training-recovery-test",
  "main": "src/recovery-worker.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": { "crons": [] },
  "observability": { "enabled": false },
  "services": [{ "binding": "BUSINESS_SOURCE_AUTHORITY", "service": "dragon-boat-training-api-c2-test", "entrypoint": "SourceAuthority" }],
  "vars": {
    "SOURCE_TEAM_ID": "pentasus-c2-test",
    "SOURCE_BACKEND_GENERATION": "cf-c2-isolated-1",
    "SOURCE_WRITER_EPOCH": "0"
  },
  "durable_objects": { "bindings": [{ "name": "RECOVERY_STATE", "class_name": "RecoveryState" }] },
  "exports": { "RecoveryState": { "type": "durable-object", "storage": "sqlite" } }
}
